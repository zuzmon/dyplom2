[node name="Default" parent="NPC_Boss/Dialogi" parent_id_path=PackedInt32Array(777428972, 569248006) index="0" unique_id=151041152]
dialog = Array[String](["sWhat are you doing here? Get back to work!"])

[node name="FirstPapers" parent="NPC_Boss/Dialogi" parent_id_path=PackedInt32Array(777428972, 569248006) index="1" unique_id=861951256]
dialog = Array[String](["sWhat took you so long? As usual, you're slow and you're never on time.", "Tch. Forget it. Send the email to the company I mentioned yesterday. Tell them that we’d like to meet on Friday at 4:00 PM to discuss the price changes.And make sure you don't take too long this time!"])

[node name="Ask" parent="NPC_Boss/Dialogi" parent_id_path=PackedInt32Array(777428972, 569248006) index="2" unique_id=245339257]
dialog = Array[String](["jExcuse me, but you didn’t say where you wanted to have the meeting.", "sI didn’t? Don’t be ridiculous. You forgot. Again.", "sLike I told you earlier, we want to meet on FRIDAY at 4:00 PM in OUR OFFICE on the second floor.", "sDid you understand? OUR OFFCIE."])

[node name="SecondPapers" parent="NPC_Boss/Dialogi" parent_id_path=PackedInt32Array(777428972, 569248006) index="3" unique_id=98931402]
dialog = Array[String](["sAre you out of your mind?! What the hell did you write?!"])

