[node name="WorkFirstEmail" type="Node" parent="NaszeBiurko/Dialogi" unique_id=908286878]
script = ExtResource("58_ae3hb")
dialog = Array[String](["jOkay. \"Dear Sir or Madam... We would like to meet at 4:00 PM... regarding the price changes...\"", "jWait. Where does that old fool want to meet them anyway?", "jUgh, I guess I have to go and ask him."])

[node name="WorkSecondEmail" type="Node" parent="NaszeBiurko/Dialogi" unique_id=854447147]
script = ExtResource("58_ae3hb")
dialog = Array[String](["j \"Dear Sir or Madam... \"", "j\"You’ve got to be f*cking kidding me. You’re not serious, and your f*cking conditions are complete bullsh*t.I don’t give a damn about your terms, and I don’t give a sh*t about you either.\"", "j\"Yours sincerely...\"", "j Aaaand... sent."])

