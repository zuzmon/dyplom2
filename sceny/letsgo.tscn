[node name="FirstPrinter" parent="NPC_Kobieta/Dialogi" parent_id_path=PackedInt32Array(839009704, 569248006) index="1" unique_id=341674911]
dialog = Array[String](["khi, Simon!", "jHi, Betty. How are you? Did you like the cake I brought you yesterday?", "kI loved it! I even shared some with Patrick because we had a date yesterday.", "jPatrick? Who's Patrick?", "kOh, didn't I tell you? He's my new boyfriend. We've been seeing each other since last week. He's such an amazing guy.", "kWe had the best date yesterday—we went to the movies, then had a romantic dinner. He even brought me a little gift: my favorite chocolates and a teddy bear!", "kI know it sounds a bit childish, but I actually brought the teddy bear to work with me. Haha. It's sitting on my desk to remind me of him.", "jOh... that's great.", "kOh, Simon, actually, I have a small favor to ask. I realized I made a few mistakes in the documents you want to print, and I really need to fix them before they go to the boss.", "kWould you mind waiting a few minutes? I'll correct them quickly and print them out right away.", "jBetty, you know the boss doesn't like waiting.", "kI know, I know. But he'll be even angrier if he gets documents with mistakes in them. Please? It'll only take a minute.", "j...okay."])

[node name="DefaultFirstPrinter" parent="NPC_Kobieta/Dialogi" parent_id_path=PackedInt32Array(839009704, 569248006) index="2" unique_id=513868141]
dialog = Array[String](["kJust one more minute."])

[node name="AfterFirstPrinter" parent="NPC_Kobieta/Dialogi" parent_id_path=PackedInt32Array(839009704, 569248006) index="3" unique_id=1885595358]
dialog = Array[String](["kI've corrected the documents. You can take them to the boss now."])

[node name="Ask" parent="NPC_Kobieta/Dialogi" parent_id_path=PackedInt32Array(839009704, 569248006) index="4" unique_id=828152197]
dialog = Array[String](["kHave you seen my teddy bear? It’s not on my desk where I left it. I don’t know where it could be.", "jNo."])

[node name="SecondPrinter" parent="NPC_Kobieta/Dialogi" parent_id_path=PackedInt32Array(839009704, 569248006) index="5" unique_id=2017042308]
dialog = Array[String](["kI'm really sorry, Simon, but I made some more mistakes in the documents again. Could you please-", "jI don't care."])

